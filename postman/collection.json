            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"print('hi')\",\n  \"filename\": \"main.py\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Depends on the server: 200 with Docker available, 503 on hosts without Docker, 400 if the first image pull exceeds the timeout."
