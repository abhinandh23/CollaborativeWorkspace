              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200, 400 or 503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 400, 503]));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns output or an error\", () => {",
                  "  if (pm.response.code === 200) pm.expect(body).to.have.keys(\"stdout\", \"stderr\");",
                  "  else pm.expect(body.error).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
