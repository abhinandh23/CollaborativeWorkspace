    {
      "name": "Files (code storage)",
      "item": [
        {
          "name": "List files",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspaces/files/?workspace={{workspaceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "files",
